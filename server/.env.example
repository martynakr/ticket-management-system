# Copy this file to .env and adjust the values. .env is git-ignored.
# The full list of variables is added in the next setup task.

PORT=3000

# MongoDB running in Docker (see compose.yaml). Port 27018, not the default 27017.
MONGODB_URI=mongodb://localhost:27018/ticket-management

# Secret for signing login tokens. Use a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# First admin account, created by `npm run seed`. Password: at least 8 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
