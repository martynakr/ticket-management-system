{
  // Used by `npm run build`: same settings, but only compiles src/, so tests
  // never end up in dist/. `npm run typecheck` uses tsconfig.json, which also
  // checks tests/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // src/index.ts compiles to dist/index.js (not dist/src/index.js).
    "rootDir": "src"
  },
  "include": ["src"]
}
